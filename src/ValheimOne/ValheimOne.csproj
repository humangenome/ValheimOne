<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Normalize source paths consistently in local and CI builds. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Keep build-machine paths out of the shipped DLL: without this the assembly
         embeds the full local path to ValheimOne.pdb, which is a build-host detail
         that has no business in a public binary. Also makes the output independent
         of where the repo is checked out. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- Do not embed the Git HEAD SHA in InformationalVersion. The provenance
         ledger row for a release lives inside the release commit, so a DLL that
         embeds its own commit SHA can never be rebuilt byte-identically from the
         tagged sources (the ledger commit differs from the build commit by
         construction). Reproducibility is proven by content-hash equality of the
         deterministic compile; the ledger records the commits. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The SDK's implicit SourceLink writes {repo URL, HEAD SHA} into the PDB,
         and the DLL embeds that PDB's checksum in its debug directory - so with
         SourceLink on, the DLL hash changes with every commit (and with the
         builder's remote-URL casing), defeating the property the ledger relies
         on above. IncludeSourceRevisionInInformationalVersion does not cover
         this; SourceLink must be off explicitly. -->
    <EnableSourceLink>false</EnableSourceLink>
    <AssemblyName>ValheimOne</AssemblyName>
    <RootNamespace>ValheimOne</RootNamespace>
    <Version>0.13.1</Version>
    <AssemblyVersion>0.13.1.0</AssemblyVersion>
    <FileVersion>0.13.1.0</FileVersion>
    <ValheimManaged>$(HOME)/valheim-modding/server/valheim_server_Data/Managed</ValheimManaged>
    <ValheimPublicized>$(HOME)/valheim-modding/publicized</ValheimPublicized>
    <BepInExCore>$(HOME)/valheim-modding/bepinex/BepInExPack_Valheim/BepInEx/core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http"><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimPublicized)/assembly_valheim_publicized.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimPublicized)/assembly_utils_publicized.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimPublicized)/assembly_guiutils_publicized.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(ValheimManaged)/SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>$(ValheimManaged)/Splatform.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ValheimManaged)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ValheimManaged)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ValheimManaged)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
